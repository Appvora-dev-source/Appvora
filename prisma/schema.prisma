generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  hasPaid       Boolean   @default(false)
  paymentDate   DateTime?
  paypalOrderId String?

  cvs          CV[]
  applications Application[]
  savedJobs    SavedJob[]
  payments     Payment[]
}

model Job {
  id          String   @id @default(uuid())
  title       String
  company     String
  description String
  location    String?
  salaryMin   Float?
  salaryMax   Float?
  currency    String   @default("GBP")
  jobType     String?  // full-time, part-time, contract, remote
  category    String?
  source      String   @default("manual") // manual, api, scrape
  sourceUrl   String?
  postedAt    DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  applications Application[]
  savedJobs    SavedJob[]
}

model CV {
  id         String   @id @default(uuid())
  userId     String
  filename   String
  originalName String
  mimeType   String
  fileSize   Int
  encryptedPath String
  encryptionIv String
  analysisJson String? // JSON string of AI analysis
  skills     String?  // JSON array of extracted skills
  experience String?  // JSON of extracted experience
  education  String?  // JSON of extracted education
  uploadedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  cvId      String?
  status    String   @default("applied") // applied, reviewing, interviewed, offered, rejected, withdrawn
  notes     String?
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cv   CV?  @relation(fields: [cvId], references: [id], onDelete: SetNull)
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  savedAt   DateTime @default(now())
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  orderId       String   @unique
  amount        Float
  currency      String   @default("GBP")
  status        String   // created, approved, completed, failed, refunded
  paypalResponse String? // JSON of PayPal response
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
